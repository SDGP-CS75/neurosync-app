# Server Configuration
PORT=8080
NODE_ENV=development

# Browser origins allowed to call the API (comma-separated).
# Production rejects cross-origin browser requests unless this is configured.
CORS_ORIGINS=http://localhost:8081

# Number of trusted reverse-proxy hops in front of Express.
# Railway/production deployments normally use 1; local development uses 0.
TRUST_PROXY_HOPS=0

# Firebase Admin Service Account Credentials (JSON string for deployment)
# e.g. FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# Alternatively, place service account JSON in src/config/sdgp-cs75-firebase-adminsdk-fbsvc-5684359436.json
FIREBASE_SERVICE_ACCOUNT=

# Set to true only for local test runs if skipping token verification
SKIP_AUTH=false

# Groq AI Service Configuration (OpenAI-compatible task breakdown API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Per-user AI spend controls (reset daily at 00:00 UTC)
AI_QUOTA_ENABLED=true
AI_DAILY_REQUEST_LIMIT=20
AI_DAILY_TOKEN_LIMIT=200000
AI_DAILY_COST_LIMIT_USD=1.00

# Groq list prices in USD per one million tokens.
GROQ_INPUT_COST_PER_1M_USD=0.05
GROQ_OUTPUT_COST_PER_1M_USD=0.08
